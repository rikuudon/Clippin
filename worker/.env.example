# ==============================================================================
# Worker Environment Variables
# ==============================================================================

# 1. Google Gemini API Key (Free tier from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Gemini Model override (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# 3. Supabase Integration (From Supabase Project Settings -> API)
# Project URL: https://xyzcompany.supabase.co
SUPABASE_URL=your_supabase_project_url_here

# Secret Service Role Key (NEVER commit this! Used for backend writes to tables & private buckets)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
